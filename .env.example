# Copy with scripts/Initialize-Local.ps1 to generate per-project random local tokens.
# Never commit .env. No API key is needed for commerce API or automated Fake Model tests.
SERVER_PORT=8080
ALICE_API_TOKEN=
BOB_API_TOKEN=
COMMERCE_SERVICE_TOKEN=
DB_PASSWORD=
DB_USER=resolveforge
# Default: file H2. For PostgreSQL, set DB_URL then run Start-Agent.ps1 -Profile postgres.
# DB_URL=jdbc:postgresql://localhost:5433/resolveforge
MODEL_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com
MODEL_ENDPOINT_PATH=/chat/completions
MODEL_NAME=deepseek-chat
MODEL_TIMEOUT_SECONDS=90
# OpenAI example: MODEL_BASE_URL=https://api.openai.com ; MODEL_ENDPOINT_PATH=/v1/chat/completions
# Base URL and endpoint are joined; do not repeat /v1 in both.
# Independent Embedding credentials. Empty key => explicitly reported BM25_ONLY mode.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=30
RAG_TOP_K=5
RAG_RECALL_K=12
RAG_BM25_MIN_SCORE=1.2
RAG_VECTOR_MIN_SCORE=0.60
RAG_LEXICAL_MIN_COVERAGE=0.35
RAG_RRF_K=60
RAG_FUSION_MIN_SCORE=0.0
